POSTGRES_DB=source_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# The opt-in live workload inserts one article at this interval.
WORKLOAD_INTERVAL_SECONDS=15

# Direct raw-data destination. Authentication uses Google Application Default Credentials.
GCP_PROJECT_ID=your-gcp-project-id
GCS_RAW_BUCKET=your-raw-bucket-name
